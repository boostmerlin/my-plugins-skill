  "plugins": [
    {
      "name": "gitnexus",
      "agents": ["detected"],
      "agentMap": { "codex": "codex" },
      "profiles": ["gitnexus"],
      "checkCommand": {
        "default": "gitnexus --version",
        "win32": "gitnexus.cmd --version"
      },
      "installCommand": {
        "default": "npm install -g gitnexus@latest",
        "win32": "npm.cmd install -g gitnexus@latest"
      },
      "setupCommand": {
        "default": "gitnexus setup -c {agent}",
        "win32": "gitnexus.cmd setup -c {agent}"
      },
      "updateCommand": {
        "default": "npm install -g gitnexus@latest",
        "win32": "npm.cmd install -g gitnexus@latest"
      },
      "uninstallCommands": [
        {
          "default": "gitnexus uninstall --force",
          "win32": "gitnexus.cmd uninstall --force"
        },
        {
          "default": "npm uninstall -g gitnexus",
          "win32": "npm.cmd uninstall -g gitnexus"
        }
      ],
      "reviewed": true
    },
    {
      "name": "codegraph",
      "agents": ["detected"],
      "agentMap": { "codex": "codex" },
      "profiles": ["codegraph"],
      "checkCommand": {
        "default": "codegraph --version",
        "win32": "codegraph.cmd --version"
      },
      "installCommand": {
        "default": "npm install -g @colbymchenry/codegraph",
        "win32": "npm.cmd install -g @colbymchenry/codegraph"
      },
      "setupCommand": {
        "default": "codegraph install --target={agent} --location=global --yes",
        "win32": "codegraph.cmd install --target={agent} --location=global --yes"
      },
      "updateCommand": {
        "default": "codegraph upgrade",
        "win32": "codegraph.cmd upgrade"
      },
      "uninstallCommands": [
        {
          "default": "codegraph uninstall --yes",
          "win32": "codegraph.cmd uninstall --yes"
        }
      ],
      "reviewed": true
    },
    {
      "name": "codebase-memory-mcp",
      "agents": ["detected"],
      "agentMap": { "codex": "codex" },
      "profiles": ["codebase-memory-mcp"],
      "checkCommand": {
        "default": "codebase-memory-mcp --version",
        "win32": "codebase-memory-mcp.cmd --version"
      },
      "installCommand": {
        "default": "npm install -g codebase-memory-mcp@latest",
        "win32": "npm.cmd install -g codebase-memory-mcp@latest"
      },
      "setupCommand": {
        "default": "codebase-memory-mcp install --clients={agent} -y",
        "win32": "codebase-memory-mcp.cmd install --clients={agent} -y"
      },
      "updateCommand": {
        "default": "npm install -g codebase-memory-mcp@latest",
        "win32": "npm.cmd install -g codebase-memory-mcp@latest"
      },
      "uninstallCommands": [
        {
          "default": "codebase-memory-mcp uninstall",
          "win32": "codebase-memory-mcp.cmd uninstall"
        },
        {
          "default": "npm uninstall -g codebase-memory-mcp",
          "win32": "npm.cmd uninstall -g codebase-memory-mcp"
        }
      ],
      "reviewed": true
    }
  ]
